# Simulation image: ROS 2 Jazzy + Gazebo Harmonic + ur_simulation_gz + ros2_control, for the Gazebo
# bench (src/slatphys_gazebo) and the no-robot tests. Same package set as the Apptainer image the
# bench was validated in (ROS 2 Jazzy, Gazebo Harmonic 8.15).
#   docker build -t slatphys-sim:jazzy -f docker/Dockerfile.sim .
#   docker/run_sim.sh                      # then, inside: scripts/sim_demo.sh   (GUI=1 for the window)
FROM ros:jazzy-ros-base

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      ros-jazzy-ur-simulation-gz \
      ros-jazzy-ur-description \
      ros-jazzy-ur-robot-driver \
      ros-jazzy-ros-gz \
      ros-jazzy-gz-ros2-control \
      ros-jazzy-ros2-control \
      ros-jazzy-ros2-controllers \
      ros-jazzy-controller-manager \
      ros-jazzy-xacro \
      ros-jazzy-tf2-ros-py \
      ros-jazzy-rviz2 \
      python3-colcon-common-extensions python3-numpy python3-yaml python3-opencv python3-pil \
      mesa-utils libgl1-mesa-dri procps psmisc \
    && rm -rf /var/lib/apt/lists/*
RUN echo 'source /opt/ros/jazzy/setup.bash' >> /etc/bash.bashrc
WORKDIR /ws
