<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>slatphys_real</name>
  <version>0.1.0</version>
  <description>SLAT-Phys real2sim / sim2real probing tasks (heavy, deformable, sort) on the lab's UR3e + Hand-E stack (ur3e_plan_runner + ENME480 bridge).</description>
  <maintainer email="rocktim@todo.todo">RocktimJyotiDas</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>ur_robot_driver</exec_depend>
  <exec_depend>ur3e_plan_runner</exec_depend>
  <exec_depend>ur3e_mrc</exec_depend>
  <exec_depend>ur3e_mrc_msgs</exec_depend>
  <exec_depend>ur_dashboard_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-pil</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
